# Copia este fichero a .env y rellena los valores vacíos. .env no se versiona.

# Usuario de PostgreSQL que crea el contenedor db.
POSTGRES_USER=traide
# Contraseña de PostgreSQL: obligatoria, elige una solo para tu máquina.
POSTGRES_PASSWORD=
# Nombre de la base de datos.
POSTGRES_DB=traide
# URL de la BD solo para ejecutar la API o Alembic fuera de Docker; en compose se construye con las tres variables anteriores.
DATABASE_URL=postgresql+psycopg://traide:<contraseña>@127.0.0.1:5432/traide

# Valores admitidos en la cabecera Host, separados por comas (protección frente a DNS rebinding).
HOSTS_ADMITIDOS=localhost,127.0.0.1
# Orígenes admitidos en las peticiones POST, separados por comas.
ORIGENES_ADMITIDOS=http://localhost:8080,http://127.0.0.1:8080

# Proveedor de datos de mercado: yfinance (Yahoo Finance) o ficheros (CSV de demo, sin conexión).
PROVEEDOR_PRECIOS=yfinance
# Ticker del índice de referencia para comparar la TWR y el backtest.
BENCHMARK_TICKER=SPY

# Clave del cliente LLM, vacía salvo que se active la funcionalidad opcional S1.
LLM_API_KEY=
